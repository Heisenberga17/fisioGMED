---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import PageHeader from "../components/PageHeader.astro";
import TeamCard from "../components/TeamCard.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

const teamMembers = [
  {
    name: "Dr. Director Clínico",
    role: "Fisioterapeuta — Director Clínico",
    bio: "Especialista en fisioterapia ortopédica y deportiva con más de 10 años de experiencia. Formado en las técnicas más avanzadas de terapia manual y rehabilitación funcional. Comprometido con la excelencia clínica y el cuidado personalizado de cada paciente.",
    isLead: true,
  },
  {
    name: "Lic. Fisioterapeuta",
    role: "Fisioterapeuta — Rehabilitación Deportiva",
    bio: "Especialista en rehabilitación deportiva y retorno seguro al deporte. Experiencia con atletas de alto rendimiento.",
    isLead: false,
  },
  {
    name: "Lic. Fisioterapeuta",
    role: "Fisioterapeuta — Terapia Manual",
    bio: "Certificada en terapia manual ortopédica. Especialista en dolor crónico y restricciones de movimiento.",
    isLead: false,
  },
  {
    name: "Lic. Fisioterapeuta",
    role: "Fisioterapeuta — Ondas de Choque",
    bio: "Experto en terapia de ondas de choque y tecnologías aplicadas a la rehabilitación musculoesquelética.",
    isLead: false,
  },
];
---

<Layout
  title="Nuestro Equipo — FisioGMED | Especialistas en Fisioterapia"
  description="Conoce al equipo de fisioterapeutas especializados de FisioGMED. Profesionales certificados comprometidos con tu recuperación en Costa del Este, Panamá."
>
  <Navbar client:load />

  <main>
    <PageHeader
      title="Nuestro Equipo"
      subtitle="Profesionales dedicados a tu bienestar y recuperación"
    />

    <!-- Lead Doctor -->
    <section class="py-16 bg-light-bg">
      <div class="max-w-7xl mx-auto px-4">
        <TeamCard
          name={teamMembers[0].name}
          role={teamMembers[0].role}
          bio={teamMembers[0].bio}
          isLead={true}
        />
      </div>
    </section>

    <!-- Team Grid -->
    <section class="py-16 bg-ice">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-heading text-navy text-center mb-12">
          Nuestro Equipo de Especialistas
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {teamMembers.slice(1).map((member) => (
            <TeamCard
              name={member.name}
              role={member.role}
              bio={member.bio}
              isLead={false}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Philosophy Section -->
    <section class="py-16 bg-light-bg">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-heading text-navy mb-6">
          Nuestra Filosofía
        </h2>
        <p class="text-body text-lg leading-relaxed mb-8">
          En FisioGMED creemos que cada paciente es único y merece un tratamiento personalizado.
          Nuestro enfoque combina la evidencia científica más actualizada con un trato humano y cercano.
          Nos comprometemos a escucharte, entender tus necesidades y trabajar contigo para alcanzar
          tus objetivos de recuperación.
        </p>
        <div class="grid md:grid-cols-3 gap-8 mt-12">
          <div class="bg-accent-light rounded-2xl p-6">
            <div class="text-3xl mb-3">🎯</div>
            <h3 class="font-heading text-navy text-lg mb-2">Excelencia Clínica</h3>
            <p class="text-body text-sm">Protocolos basados en la última evidencia científica internacional.</p>
          </div>
          <div class="bg-accent-light rounded-2xl p-6">
            <div class="text-3xl mb-3">❤️</div>
            <h3 class="font-heading text-navy text-lg mb-2">Trato Humano</h3>
            <p class="text-body text-sm">Cada paciente es tratado con empatía, respeto y dedicación personalizada.</p>
          </div>
          <div class="bg-accent-light rounded-2xl p-6">
            <div class="text-3xl mb-3">📈</div>
            <h3 class="font-heading text-navy text-lg mb-2">Resultados Medibles</h3>
            <p class="text-body text-sm">Seguimiento objetivo de tu progreso con metas claras y alcanzables.</p>
          </div>
        </div>
      </div>
    </section>

    <CtaBanner />
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>
