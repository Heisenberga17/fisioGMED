---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import PageHeader from "../components/PageHeader.astro";
import ServiceBlock from "../components/ServiceBlock.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { services } from "../data/services";
---

<Layout
  title="Servicios — FisioGMED | Fisioterapia Especializada en Panamá"
  description="Conoce nuestros servicios de fisioterapia: rehabilitación deportiva, terapia manual, dolor de columna, rehabilitación post-quirúrgica, fisioterapia preventiva y ondas de choque."
>
  <Navbar client:load />

  <main>
    <PageHeader
      title="Nuestros Servicios"
      subtitle="Tratamientos especializados respaldados por la evidencia científica para tu recuperación óptima"
    />

    {services.map((service, index) => (
      <ServiceBlock
        id={service.id}
        name={service.name}
        icon={service.icon}
        fullDescription={service.fullDescription}
        treatments={service.treatments}
        reversed={index % 2 !== 0}
      />
    ))}

    <CtaBanner />
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>
