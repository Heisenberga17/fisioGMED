---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import PageHeader from "../components/PageHeader.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { services } from "../data/services";

const clinico = services.filter((s) => s.category === "clinico");
const rendimiento = services.filter((s) => s.category === "rendimiento");
const tecnologia = services.filter((s) => s.category === "tecnologia");

const clinicoIcons: Record<string, string> = {
  "ortopedia": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2v4m0 12v4M8 6a4 4 0 018 0v2a2 2 0 01-2 2h-4a2 2 0 01-2-2V6zm0 10a2 2 0 012-2h4a2 2 0 012 2v2a4 4 0 01-8 0v-2z"/></svg>`,
  "fisioterapia-deportiva": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="14" cy="4" r="2" stroke-width="1.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21l3-7m4-4l3-3m-3 3l-4 4-3-1m7-3l2 5m-2-5H9.5"/></svg>`,
  "rehabilitacion-ortopedica": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v4m0 0H8m4 0h4M9 20l3-6 3 6M5 14h14"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v6"/></svg>`,
  "adulto-mayor": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="4.5" r="2" stroke-width="1.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 8h-2a1 1 0 00-1 1v5h1v7h2v-7h1V9a1 1 0 00-1-1zm-5 6l-2 7m0 0h2"/></svg>`,
};

const rendimientoIcons: Record<string, string> = {
  "readaptacion-deportiva": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>`,
  "nutricion-deportiva": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1M5 12H4m16 0h1"/><circle cx="12" cy="12" r="5" stroke-width="1.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v6m-3-3h6"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 3.5c-1-.3-2-.5-3-.5s-2 .2-3 .5M15 20.5c-1 .3-2 .5-3 .5s-2-.2-3-.5"/></svg>`,
  "recovery-deportivo": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`,
};

const technology = [
  {
    name: "Láser de Alta Intensidad",
    description: "Reduce dolor e inflamación de forma rápida, estimulando la regeneración celular y acelerando la curación.",
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`,
  },
  {
    name: "Game Ready",
    description: "Sistema de compresión y frío utilizado por equipos profesionales para recuperación post-esfuerzo y post-operatoria.",
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>`,
  },
  {
    name: "VertiMax",
    description: "Plataforma innovadora para mejorar fuerza, potencia, velocidad y rendimiento funcional en rehabilitación.",
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>`,
  },
  {
    name: "Sistemas Inerciales",
    description: "Método Yo-Yo para mejorar el control neuromuscular, la potencia y la prevención de re-lesiones.",
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`,
  },
];
---

<Layout
  title="Servicios — FisioGMED | Fisioterapia Especializada en Panamá"
  description="Conoce nuestros servicios: ortopedia, fisioterapia deportiva, rehabilitación ortopédica, readaptación deportiva, ondas de choque, tecarterapia, nutrición deportiva y tecnología de recuperación avanzada."
>
  <Navbar client:load />

  <main>
    <PageHeader
      title="Nuestros Servicios"
      subtitle="Tratamientos especializados respaldados por la evidencia científica para tu recuperación óptima"
    />

    <!-- ============================================ -->
    <!-- CATEGORY 1: Servicios Clínicos — Navy Banner -->
    <!-- ============================================ -->
    <section class="py-10 relative overflow-hidden bg-navy">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 24px 24px;"></div>
      <div class="max-w-7xl mx-auto px-4 relative z-10">
        <p class="text-accent text-sm uppercase tracking-widest font-body mb-2">01</p>
        <h2 class="text-3xl md:text-4xl font-heading text-white">Servicios Clínicos</h2>
        <p class="text-slate-blue mt-2">Diagnóstico, tratamiento y rehabilitación integral</p>
      </div>
    </section>

    <!-- Clinico — 2x2 Card Grid -->
    <section class="bg-light-bg py-16">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-6">
          {clinico.map((service) => (
            <div id={service.id} class="scroll-reveal stagger-item card-hover bg-white rounded-2xl p-8 shadow-md border border-navy/[0.06]">
              <div class="flex items-start gap-5 mb-4">
                {clinicoIcons[service.id] ? (
                  <div class="icon-container text-accent shrink-0" set:html={clinicoIcons[service.id]} />
                ) : (
                  <div class="text-4xl shrink-0">{service.icon}</div>
                )}
                <div>
                  <h3 class="text-xl font-heading text-navy mb-2">{service.name}</h3>
                  <p class="text-body text-sm leading-relaxed">{service.shortDescription}</p>
                </div>
              </div>
              <ul class="space-y-2 mt-4 pl-1">
                {service.treatments.map((treatment) => (
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-body text-sm">{treatment}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===================================================== -->
    <!-- CATEGORY 2: Rendimiento — Left bar + Horizontal Strips -->
    <!-- ===================================================== -->
    <section class="py-10 bg-white">
      <div class="max-w-7xl mx-auto px-4 flex items-start gap-4">
        <div class="w-1 h-16 bg-accent rounded-full shrink-0"></div>
        <div>
          <p class="text-accent text-sm uppercase tracking-widest font-body mb-2">02</p>
          <h2 class="text-3xl md:text-4xl font-heading text-navy">Rendimiento y Recuperación</h2>
          <p class="text-body mt-2">Lleva tu rendimiento al siguiente nivel</p>
        </div>
      </div>
    </section>

    <!-- Rendimiento — Horizontal Strips -->
    <section class="bg-light-bg py-12">
      <div class="max-w-7xl mx-auto px-4 space-y-4">
        {rendimiento.map((service) => (
          <div id={service.id} class="scroll-reveal stagger-item card-hover bg-white rounded-xl p-6 border-l-4 border-accent shadow-sm flex flex-col lg:flex-row lg:items-center gap-6">
            <!-- Icon + Name -->
            <div class="flex items-center gap-4 lg:min-w-[260px] shrink-0">
              {rendimientoIcons[service.id] ? (
                <div class="icon-container text-accent shrink-0" set:html={rendimientoIcons[service.id]} />
              ) : (
                <div class="text-3xl shrink-0">{service.icon}</div>
              )}
              <h3 class="text-lg font-heading text-navy">{service.name}</h3>
            </div>
            <!-- Description -->
            <p class="text-body text-sm leading-relaxed flex-grow">{service.shortDescription}</p>
            <!-- Treatment Pills -->
            <div class="flex flex-wrap gap-2 lg:max-w-sm shrink-0">
              {service.treatments.map((treatment) => (
                <span class="text-xs bg-ice border border-accent/15 text-navy rounded-full px-3 py-1.5">{treatment}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ============================================== -->
    <!-- Tecnología de Recuperación Avanzada (Showcase) -->
    <!-- ============================================== -->
    <section class="py-16 relative overflow-hidden" style="background: linear-gradient(180deg, #1B2545 0%, #2A3A6B 100%);">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 24px 24px;"></div>
      <div class="max-w-7xl mx-auto px-4 relative z-10">
        <div class="text-center mb-12">
          <p class="text-[#00C2FF] text-sm font-semibold uppercase tracking-widest font-body mb-3">Tecnología</p>
          <h2 class="text-3xl md:text-4xl font-heading text-white mb-4">
            Tecnología de Recuperación Avanzada
          </h2>
          <div class="w-20 h-1 bg-gradient-to-r from-accent via-[#00A3D9] to-accent rounded-full mx-auto mb-6"></div>
          <p class="text-slate-blue text-lg font-body max-w-2xl mx-auto">
            Equipos de última generación para acelerar tu recuperación
          </p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {technology.map((tech) => (
            <div class="bg-white/10 backdrop-blur-sm border border-white/10 rounded-2xl p-6 text-center hover:bg-white/15 transition-colors duration-300">
              <div class="w-16 h-16 rounded-full bg-white/10 flex items-center justify-center mx-auto mb-4 text-[#00C2FF]">
                <Fragment set:html={tech.icon} />
              </div>
              <h3 class="font-heading text-white text-lg mb-2">{tech.name}</h3>
              <p class="text-slate-blue text-sm font-body">{tech.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================================================ -->
    <!-- CATEGORY 3: Tecnología y Modalidades — Centered  -->
    <!-- ================================================ -->
    <section class="py-10 bg-ice">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <p class="text-accent text-sm uppercase tracking-widest font-body mb-2">03</p>
        <h2 class="text-3xl md:text-4xl font-heading text-navy">Tecnología y Modalidades</h2>
        <div class="accent-bar mx-auto mt-4"></div>
      </div>
    </section>

    <!-- Tecnologia — Tall Vertical Cards -->
    <section class="bg-white py-16">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid md:grid-cols-3 gap-8">
          {tecnologia.map((service) => (
            <ServiceCard
              id={service.id}
              name={service.name}
              fullDescription={service.fullDescription}
              treatments={service.treatments}
            />
          ))}
        </div>
      </div>
    </section>

    <CtaBanner />
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>
