---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import PageHeader from "../components/PageHeader.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { services } from "../data/services";

const clinico = services.filter((s) => s.category === "clinico");
const rendimiento = services.filter((s) => s.category === "rendimiento");
const tecnologia = services.filter((s) => s.category === "tecnologia");

const clinicoIcons: Record<string, string> = {
  "ortopedia": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2v4m0 12v4M8 6a4 4 0 018 0v2a2 2 0 01-2 2h-4a2 2 0 01-2-2V6zm0 10a2 2 0 012-2h4a2 2 0 012 2v2a4 4 0 01-8 0v-2z"/></svg>`,
  "fisioterapia-deportiva": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="14" cy="4" r="2" stroke-width="1.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21l3-7m4-4l3-3m-3 3l-4 4-3-1m7-3l2 5m-2-5H9.5"/></svg>`,
  "rehabilitacion-ortopedica": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2v7m0 6v7"/><circle cx="12" cy="12" r="3" stroke-width="1.5"/><path stroke-linecap="round" stroke-width="1.5" d="M18 7a8 8 0 010 10" stroke-dasharray="3 2"/></svg>`,
  "adulto-mayor": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="4.5" r="2" stroke-width="1.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 8h-2a1 1 0 00-1 1v5h1v7h2v-7h1V9a1 1 0 00-1-1zm-5 6l-2 7m0 0h2"/></svg>`,
};

const rendimientoIcons: Record<string, string> = {
  "readaptacion-deportiva": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>`,
  "nutricion-deportiva": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v3"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 3c.5.5.5 1.5 0 2.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 7C7.5 7 5 10.5 5 14.5 5 18.5 8 22 12 22s7-3.5 7-7.5S16.5 7 12 7z"/></svg>`,
  "recovery-deportivo": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 11c-1.5 0-3 1-3 3s1.5 3 3 3"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 11c1.5 0 3 1 3 3s-1.5 3-3 3"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 14c2-3 3-5 5-6 2 1 3 3 5 6"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v2m-4 1l1 1m7-1l-1 1"/></svg>`,
};

const technology = [
  {
    name: "Láser de Alta Intensidad",
    description: "Reduce dolor e inflamación de forma rápida, estimulando la regeneración celular y acelerando la curación.",
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" stroke-width="1.5"/><circle cx="12" cy="12" r="3" stroke-width="1.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2v4m0 12v4M2 12h4m12 0h4"/></svg>`,
  },
  {
    name: "Game Ready",
    description: "Sistema de compresión y frío utilizado por equipos profesionales para recuperación post-esfuerzo y post-operatoria.",
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2v20M4 7l16 10M20 7L4 17"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 4l2 2 2-2M10 20l2-2 2 2M5.5 8.5l2 .5-.5-2M18.5 8.5l-2 .5.5-2M5.5 15.5l2-.5-.5 2M18.5 15.5l-2-.5.5 2"/></svg>`,
  },
  {
    name: "VertiMax",
    description: "Plataforma innovadora para mejorar fuerza, potencia, velocidad y rendimiento funcional en rehabilitación.",
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 19V5m0 0l-5 5m5-5l5 5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 21h14"/></svg>`,
  },
  {
    name: "Sistemas Inerciales",
    description: "Método Yo-Yo para mejorar el control neuromuscular, la potencia y la prevención de re-lesiones.",
    icon: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3" stroke-width="1.5"/></svg>`,
  },
];
---

<Layout
  title="Servicios — FisioGMED | Fisioterapia Especializada en Panamá"
  description="Conoce nuestros servicios: ortopedia, fisioterapia deportiva, rehabilitación ortopédica, readaptación deportiva, ondas de choque, tecarterapia, nutrición deportiva y tecnología de recuperación avanzada."
>
  <Navbar client:load />

  <main>
    <PageHeader
      title="Nuestros Servicios"
      subtitle="Tratamientos especializados respaldados por la evidencia científica para tu recuperación óptima"
    />

    <section class="bg-light-bg py-16">
      <div class="max-w-7xl mx-auto px-4">
        <div class="mb-10">
          <p class="text-accent text-sm uppercase tracking-widest font-body font-semibold mb-2">01</p>
          <h2 class="text-3xl md:text-4xl font-heading text-navy mb-2">Servicios Clínicos</h2>
          <p class="text-body">Diagnóstico, tratamiento y rehabilitación integral</p>
          <div class="accent-bar mt-4"></div>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {clinico.map((service) => (
            <div id={service.id} class="scroll-reveal stagger-item card-hover bg-white rounded-2xl p-8 shadow-md border border-navy/[0.06]">
              <div class="flex items-start gap-5 mb-4">
                {clinicoIcons[service.id] ? (
                  <div class="icon-container text-accent shrink-0" set:html={clinicoIcons[service.id]} />
                ) : (
                  <div class="text-4xl shrink-0">{service.icon}</div>
                )}
                <div>
                  <h3 class="text-xl font-heading text-navy mb-2">{service.name}</h3>
                  <p class="text-body text-sm leading-relaxed">{service.shortDescription}</p>
                </div>
              </div>
              <ul class="space-y-2 mt-4 pl-1">
                {service.treatments.map((treatment) => (
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-body text-sm">{treatment}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white py-16">
      <div class="max-w-7xl mx-auto px-4">
        <div class="mb-10">
          <p class="text-accent text-sm uppercase tracking-widest font-body font-semibold mb-2">02</p>
          <h2 class="text-3xl md:text-4xl font-heading text-navy mb-2">Rendimiento y Recuperación</h2>
          <p class="text-body">Lleva tu rendimiento al siguiente nivel</p>
          <div class="accent-bar mt-4"></div>
        </div>
        <div class="space-y-4">
          {rendimiento.map((service) => (
            <div id={service.id} class="scroll-reveal stagger-item card-hover bg-white rounded-xl p-6 border border-navy/[0.06] shadow-sm flex flex-col lg:flex-row lg:items-center gap-6">
              <div class="flex items-center gap-4 lg:min-w-[260px] shrink-0">
                {rendimientoIcons[service.id] ? (
                  <div class="icon-container text-accent shrink-0" set:html={rendimientoIcons[service.id]} />
                ) : (
                  <div class="text-3xl shrink-0">{service.icon}</div>
                )}
                <h3 class="text-lg font-heading text-navy">{service.name}</h3>
              </div>
              <p class="text-body text-sm leading-relaxed flex-grow">{service.shortDescription}</p>
              <div class="flex flex-wrap gap-2 lg:max-w-sm shrink-0">
                {service.treatments.map((treatment) => (
                  <span class="text-xs bg-ice border border-accent/15 text-navy rounded-full px-3 py-1.5">{treatment}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 relative overflow-hidden" style="background: linear-gradient(180deg, #1B2545 0%, #2A3A6B 100%);">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 24px 24px;"></div>
      <div class="max-w-7xl mx-auto px-4 relative z-10">
        <div class="text-center mb-12">
          <p class="text-[#00C2FF] text-sm font-semibold uppercase tracking-widest font-body mb-3">Tecnología</p>
          <h2 class="text-3xl md:text-4xl font-heading text-white mb-4">
            Tecnología de Recuperación Avanzada
          </h2>
          <div class="w-20 h-1 bg-gradient-to-r from-accent via-[#00A3D9] to-accent rounded-full mx-auto mb-6"></div>
          <p class="text-slate-blue text-lg font-body max-w-2xl mx-auto">
            Equipos de última generación para acelerar tu recuperación
          </p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {technology.map((tech) => (
            <div class="bg-white/10 backdrop-blur-sm border border-white/10 rounded-2xl p-6 text-center hover:bg-white/15 transition-colors duration-300">
              <div class="w-16 h-16 rounded-full bg-white/10 flex items-center justify-center mx-auto mb-4 text-[#00C2FF]">
                <Fragment set:html={tech.icon} />
              </div>
              <h3 class="font-heading text-white text-lg mb-2">{tech.name}</h3>
              <p class="text-slate-blue text-sm font-body">{tech.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-light-bg py-16">
      <div class="max-w-7xl mx-auto px-4">
        <div class="mb-10">
          <p class="text-accent text-sm uppercase tracking-widest font-body font-semibold mb-2">03</p>
          <h2 class="text-3xl md:text-4xl font-heading text-navy mb-2">Tecnología y Modalidades</h2>
          <p class="text-body">Equipos especializados para tratamientos de vanguardia</p>
          <div class="accent-bar mt-4"></div>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          {tecnologia.map((service) => (
            <ServiceCard
              id={service.id}
              name={service.name}
              fullDescription={service.fullDescription}
              treatments={service.treatments}
            />
          ))}
        </div>
      </div>
    </section>

    <CtaBanner />
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>
