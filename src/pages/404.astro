---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Página No Encontrada — FisioGMED"
  description="La página que buscas no existe. Vuelve al inicio de FisioGMED."
>
  <Navbar client:load />

  <main class="flex-1 flex items-center justify-center py-32 relative overflow-hidden">
    <!-- Floating decorative element -->
    <div class="floating-circle w-64 h-64 -top-16 -right-16 border-accent/10 opacity-40" style="animation: floatSlow 8s ease-in-out infinite;" aria-hidden="true"></div>

    <div class="text-center px-4 relative z-10">
      <p class="text-8xl font-heading text-accent mb-4" style="animation: scaleIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;">404</p>
      <h1 class="text-3xl md:text-4xl font-heading text-navy mb-4" style="animation: heroFadeUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;">
        Página No Encontrada
      </h1>
      <p class="text-body text-lg mb-8 max-w-md mx-auto" style="animation: heroFadeUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;">
        Lo sentimos, la página que buscas no existe o ha sido movida.
      </p>
      <a
        href="/"
        class="btn-primary inline-block bg-accent hover:bg-accent-dark text-white font-semibold rounded-full px-8 py-4"
        style="animation: heroFadeUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.45s both;"
      >
        Volver al Inicio
      </a>
    </div>
  </main>

  <Footer />
</Layout>
