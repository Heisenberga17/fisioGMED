---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import PageHeader from "../components/PageHeader.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import FaqAccordion from "../components/FaqAccordion";
import FirstVisitGuide from "../components/FirstVisitGuide.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { testimonials } from "../data/testimonials";
---

<Layout
  title="Pacientes — FisioGMED | Testimonios y Preguntas Frecuentes"
  description="Lee los testimonios de nuestros pacientes, consulta preguntas frecuentes y prepárate para tu primera visita a FisioGMED en Costa del Este, Panamá."
>
  <Navbar client:load />

  <main>
    <PageHeader
      title="Nuestros Pacientes"
      subtitle="Historias de recuperación y toda la información que necesitas"
    />

    <!-- Testimonials Section -->
    <section class="py-16 bg-light-bg">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-heading text-navy text-center mb-12">
          Testimonios
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {testimonials.map((t) => (
            <TestimonialCard
              name={t.name}
              role={t.role}
              quote={t.quote}
              rating={t.rating}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-heading text-navy text-center mb-4">
          Preguntas Frecuentes
        </h2>
        <p class="text-body text-center mb-12 max-w-2xl mx-auto">
          Respuestas a las dudas más comunes de nuestros pacientes
        </p>
        <FaqAccordion client:visible />
      </div>
    </section>

    <!-- First Visit Guide -->
    <FirstVisitGuide />

    <CtaBanner />
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>
