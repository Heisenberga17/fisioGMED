---
---

<footer class="bg-navy text-white relative overflow-hidden">
  <!-- Gradient accent line at top -->
  <div class="h-[5px] bg-gradient-to-r from-[#00C2FF] via-[#00A3D9] to-[#00C2FF]" aria-hidden="true"></div>

  <!-- Subtle radial glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] pointer-events-none" style="background: radial-gradient(ellipse at center, rgba(0, 194, 255, 0.06) 0%, transparent 70%);" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr] items-start gap-10 lg:gap-12">
      <!-- Brand Column -->
      <div class="scroll-reveal">
        <img src="/logo.png" alt="FisioGMED" class="h-12 w-auto brightness-0 invert mb-2" loading="lazy" />
        <p class="text-xs text-slate-blue uppercase tracking-wider mb-4">Fisioterapia & Ortopedia Deportiva</p>
        <p class="text-slate-blue text-sm leading-relaxed mb-6">
          Clínica líder en fisioterapia y rehabilitación en Costa del Este,
          Panamá. Comprometidos con tu recuperación y bienestar a través de
          tratamientos basados en evidencia.
        </p>
        <a
          href="https://www.instagram.com/fisiogmed/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Síguenos en Instagram"
          class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-navy-light hover:bg-accent transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-accent/20"
        >
          <svg
            class="w-5 h-5 text-white"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
      </div>

      <!-- Quick Links -->
      <div class="scroll-reveal stagger-item">
        <h4 class="text-lg font-heading text-white mb-4">Enlaces Rápidos</h4>
        <ul class="space-y-3">
          <li>
            <a href="/" class="text-slate-blue hover:text-white transition-colors duration-200 text-sm">Inicio</a>
          </li>
          <li>
            <a href="/servicios" class="text-slate-blue hover:text-white transition-colors duration-200 text-sm">Servicios</a>
          </li>
          <li>
            <a href="/equipo" class="text-slate-blue hover:text-white transition-colors duration-200 text-sm">Equipo</a>
          </li>
          <li>
            <a href="/pacientes" class="text-slate-blue hover:text-white transition-colors duration-200 text-sm">Pacientes</a>
          </li>
          <li>
            <a href="/contacto" class="text-slate-blue hover:text-white transition-colors duration-200 text-sm">Contacto</a>
          </li>
        </ul>
      </div>

      <!-- Services -->
      <div class="scroll-reveal stagger-item">
        <h4 class="text-lg font-heading text-white mb-4">Servicios</h4>
        <ul class="space-y-3">
          <li>
            <a href="/servicios#fisioterapia-deportiva" class="text-slate-blue hover:text-white transition-colors duration-200 text-sm">Fisioterapia Deportiva</a>
          </li>
          <li>
            <a href="/servicios#rehabilitacion-ortopedica" class="text-slate-blue hover:text-white transition-colors duration-200 text-sm">Rehabilitación Ortopédica</a>
          </li>
          <li>
            <a href="/servicios#readaptacion-deportiva" class="text-slate-blue hover:text-white transition-colors duration-200 text-sm">Readaptación Deportiva</a>
          </li>
          <li>
            <a href="/servicios#ondas-choque" class="text-slate-blue hover:text-white transition-colors duration-200 text-sm">Ondas de Choque</a>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="scroll-reveal stagger-item">
        <h4 class="text-lg font-heading text-white mb-4">Contacto</h4>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <a href="tel:+5072833281" class="text-slate-blue hover:text-white transition-colors duration-200 text-sm">283-3281</a>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
            </svg>
            <a href="https://wa.me/50767573153" target="_blank" rel="noopener noreferrer" class="text-slate-blue hover:text-white transition-colors duration-200 text-sm">6757-3153 (WhatsApp)</a>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <a href="mailto:citas@fisiogmed.com" class="text-slate-blue hover:text-white transition-colors duration-200 text-sm">citas@fisiogmed.com</a>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span class="text-slate-blue text-sm">Plaza 770, Costa del Este,<br />Ciudad de Panamá</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-navy-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-2">
      <p class="text-slate-blue text-sm">
        &copy; 2025 FisioGMED. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
