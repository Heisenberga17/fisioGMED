---
import { testimonials } from "../data/testimonials";

const featured = testimonials.slice(0, 3);
---

<section class="section-tinted py-20">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-14 scroll-reveal">
      <h2 class="font-heading text-4xl md:text-5xl text-navy mb-4">
        Lo Que Dicen Nuestros Pacientes
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {featured.map((testimonial) => (
        <div class="scroll-reveal stagger-item card-hover bg-white rounded-2xl p-8 shadow-sm flex flex-col relative overflow-hidden">
          <!-- Accent gradient top border -->
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-accent via-accent-dark to-accent"></div>
          <!-- Stars -->
          <div class="text-yellow-400 text-xl mb-4">
            {Array.from({ length: testimonial.rating }).map(() => (
              <span>&#9733;</span>
            ))}
          </div>
          <!-- Quote -->
          <p class="text-body italic font-body mb-6 flex-grow">
            "{testimonial.quote}"
          </p>
          <!-- Author -->
          <div>
            <span class="font-bold text-navy">— {testimonial.name}</span>
            <span class="block text-sm text-slate-blue font-body mt-1">{testimonial.role}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-10 scroll-reveal">
      <a
        href="/pacientes"
        class="arrow-link text-accent hover:text-accent-dark font-semibold font-body transition-colors duration-200"
      >
        Ver más testimonios <span class="arrow">&rarr;</span>
      </a>
    </div>
  </div>
</section>
