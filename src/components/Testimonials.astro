---
import { testimonials } from "../data/testimonials";

const featured = testimonials.slice(0, 6);
---

<section class="bg-ice py-24 relative">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-14 scroll-reveal">
      <p class="text-accent text-sm font-semibold uppercase tracking-widest mb-3">Testimonios</p>
      <h2 class="text-4xl md:text-5xl text-navy font-extrabold tracking-tight mb-4">
        Lo Que Dicen Nuestros Pacientes
      </h2>
      <div class="accent-bar mx-auto mt-4 mb-4"></div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {featured.map((testimonial) => (
        <div class="scroll-reveal stagger-item card-hover bg-white rounded-2xl p-5 md:p-8 shadow-md flex flex-col relative overflow-hidden border border-navy/[0.06]">
          <!-- Accent top border -->
          <div class="absolute top-0 left-0 right-0 h-1 bg-accent"></div>
          <!-- Stars -->
          <div class="text-amber-400 text-lg mb-3 flex gap-0.5">
            {Array.from({ length: testimonial.rating }).map(() => (
              <span>&#9733;</span>
            ))}
          </div>
          <!-- Quote -->
          <p class="text-body italic mb-6 flex-grow leading-relaxed">
            &ldquo;{testimonial.quote}&rdquo;
          </p>
          <!-- Author -->
          <div class="flex items-center gap-3">
            <!-- Google icon -->
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            <div>
              <span class="font-bold text-navy text-sm">{testimonial.name}</span>
              {testimonial.date && (
                <span class="block text-xs text-slate-blue">{testimonial.date}</span>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-10 scroll-reveal">
      <a
        href="/pacientes"
        class="arrow-link text-accent hover:text-accent-dark font-semibold text-lg transition-colors duration-200"
      >
        Ver mas testimonios <span class="arrow">&rarr;</span>
      </a>
    </div>
  </div>
</section>
