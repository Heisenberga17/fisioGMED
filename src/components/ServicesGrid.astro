  "dolor-columna": `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2C12 2 10 4 10 6s1 3 2 4c1-1 2-2 2-4s-2-4-2-4zM12 10c-1 1-2 2-2 4s2 4 2 4 2-2 2-4-1-3-2-4zM12 18c-1 1-1.5 2-1.5 3s.5 2 1.5 2 1.5-1 1.5-2-.5-2-1.5-3z"/></svg>`,
  "post-quirurgico": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
  "fisioterapia-preventiva": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  "ondas-choque": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
  "nutricion": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`,
  "magnetoterapia": `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4h4v6a4 4 0 108 0V4h4v6a8 8 0 01-16 0V4z"/></svg>`,
  "tecarterapia": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
  "adulto-mayor": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`,
};

const cardColors = [
  "from-accent/10 to-accent/5",
  "from-sky/10 to-sky/5",
  "from-navy/10 to-navy/5",
  "from-accent/10 to-accent/5",
  "from-sky/10 to-sky/5",
  "from-navy/10 to-navy/5",
  "from-accent/10 to-accent/5",
  "from-sky/10 to-sky/5",
  "from-navy/10 to-navy/5",
  "from-accent/10 to-accent/5",
];
---

<section class="section-dots bg-ice py-20">
  <div class="max-w-7xl mx-auto px-4 relative z-10">
    <div class="text-center mb-14 scroll-reveal">
      <h2 class="font-heading text-4xl md:text-5xl text-navy mb-4">
        Nuestros Servicios
      </h2>
      <p class="text-body text-lg font-body max-w-2xl mx-auto">
        Soluciones especializadas para cada necesidad
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service, i) => (
        <div class="scroll-reveal stagger-item card-hover bg-white rounded-2xl shadow-md p-8 flex flex-col">
          <div class={`icon-container mb-5 text-accent`}>
            <Fragment set:html={serviceIcons[service.id] || `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`} />
          </div>
          <h3 class="text-xl font-heading text-navy mb-3">{service.name}</h3>
          <p class="text-body font-body mb-6 flex-grow">{service.shortDescription}</p>
          <a
            href={`/servicios#${service.id}`}
            class="arrow-link text-accent hover:text-accent-dark font-semibold font-body transition-colors duration-200"
          >
            Saber más <span class="arrow">&rarr;</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
