---
import { services } from "../data/services";

const featured = services.slice(0, 6);

const serviceIcons: Record<string, string> = {
  "ortopedia": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2v4m0 12v4M8 6a4 4 0 018 0v2a2 2 0 01-2 2h-4a2 2 0 01-2-2V6zm0 10a2 2 0 012-2h4a2 2 0 012 2v2a4 4 0 01-8 0v-2z"/></svg>`,
  "fisioterapia-deportiva": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="14" cy="4" r="2" stroke-width="1.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21l3-7m4-4l3-3m-3 3l-4 4-3-1m7-3l2 5m-2-5H9.5"/></svg>`,
  "rehabilitacion-ortopedica": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2v7m0 6v7"/><circle cx="12" cy="12" r="3" stroke-width="1.5"/><path stroke-linecap="round" stroke-width="1.5" d="M18 7a8 8 0 010 10" stroke-dasharray="3 2"/></svg>`,
  "readaptacion-deportiva": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>`,
  "adulto-mayor": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="4.5" r="2" stroke-width="1.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 8h-2a1 1 0 00-1 1v5h1v7h2v-7h1V9a1 1 0 00-1-1zm-5 6l-2 7m0 0h2"/></svg>`,
  "ondas-choque": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" stroke-width="1.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/><circle cx="12" cy="12" r="7" stroke-width="1" stroke-dasharray="3 2"/></svg>`,
  "tecarterapia": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 17c2-4 4-8 9-8s7 4 9 8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 15c1.5-3 3-5 6-5s4.5 2 6 5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 13c1-1.5 1.8-2.5 3-2.5s2 1 3 2.5"/></svg>`,
  "nutricion-deportiva": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v3"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 3c.5.5.5 1.5 0 2.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 7C7.5 7 5 10.5 5 14.5 5 18.5 8 22 12 22s7-3.5 7-7.5S16.5 7 12 7z"/></svg>`,
  "fisioterapia-domicilio": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
  "recovery-deportivo": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 11c-1.5 0-3 1-3 3s1.5 3 3 3"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 11c1.5 0 3 1 3 3s-1.5 3-3 3"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 14c2-3 3-5 5-6 2 1 3 3 5 6"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v2m-4 1l1 1m7-1l-1 1"/></svg>`,
};
---

<section class="bg-ice py-24 relative">
  <div class="max-w-7xl mx-auto px-4 relative z-10">
    <div class="text-center mb-14 scroll-reveal">
      <p class="text-accent text-sm font-semibold uppercase tracking-widest font-body mb-3">Especialidades</p>
      <h2 class="font-heading text-4xl md:text-5xl text-navy mb-4 font-extrabold uppercase tracking-tight">
        Que Hacemos
      </h2>
      <div class="accent-bar mx-auto mt-4 mb-4"></div>
      <p class="text-body text-lg font-body max-w-2xl mx-auto">
        Servicios clinicos, de rendimiento y tecnologia de elite
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {featured.map((service) => (
        <div class="scroll-reveal stagger-item card-hover bg-white rounded-2xl shadow-md hover:shadow-lg p-5 md:p-8 flex flex-col border border-navy/[0.06] transition-colors">
          <div class={`icon-container mb-5 text-accent bg-accent-light border border-accent/20 rounded-xl p-3 inline-flex`}>
            <Fragment set:html={serviceIcons[service.id] || `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`} />
          </div>
          <h3 class="text-xl font-heading text-navy mb-3">{service.name}</h3>
          <p class="text-body font-body mb-6 flex-grow">{service.shortDescription}</p>
          <a
            href={`/servicios#${service.id}`}
            class="arrow-link text-accent hover:text-accent-dark font-semibold font-body transition-colors duration-200"
          >
            Saber más <span class="arrow">&rarr;</span>
          </a>
        </div>
      ))}
    </div>

    <div class="text-center mt-12 scroll-reveal">
      <a
        href="/servicios"
        class="arrow-link text-accent hover:text-accent-dark font-semibold font-body text-lg transition-colors duration-200"
      >
        Ver todos los servicios <span class="arrow">&rarr;</span>
      </a>
    </div>
  </div>
</section>
