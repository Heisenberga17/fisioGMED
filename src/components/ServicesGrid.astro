---
import { services } from "../data/services";

const featured = services.slice(0, 6);

const serviceIcons: Record<string, string> = {
  "ortopedia": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2C12 2 10 4 10 6s1 3 2 4c1-1 2-2 2-4s-2-4-2-4zM12 10c-1 1-2 2-2 4s2 4 2 4 2-2 2-4-1-3-2-4zM12 18c-1 1-1.5 2-1.5 3s.5 2 1.5 2 1.5-1 1.5-2-.5-2-1.5-3z"/></svg>`,
  "fisioterapia-deportiva": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
  "rehabilitacion-ortopedica": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
  "readaptacion-deportiva": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>`,
  "adulto-mayor": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`,
  "ondas-choque": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
  "tecarterapia": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
  "nutricion-deportiva": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`,
  "fisioterapia-domicilio": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
  "recovery-deportivo": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`,
};
---

<section class="bg-ice py-24 relative">
  <div class="max-w-7xl mx-auto px-4 relative z-10">
    <div class="text-center mb-14 scroll-reveal">
      <p class="text-accent text-sm font-semibold uppercase tracking-widest font-body mb-3">Especialidades</p>
      <h2 class="font-heading text-4xl md:text-5xl text-navy mb-4">
        Que Hacemos
      </h2>
      <div class="accent-bar mx-auto mt-4 mb-4"></div>
      <p class="text-body text-lg font-body max-w-2xl mx-auto">
        Servicios clinicos, de rendimiento y tecnologia de elite
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {featured.map((service) => (
        <div class="scroll-reveal stagger-item card-hover bg-white rounded-2xl shadow-md hover:shadow-lg p-8 flex flex-col border border-navy/[0.06] transition-colors">
          <div class={`icon-container mb-5 text-accent`}>
            <Fragment set:html={serviceIcons[service.id] || `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`} />
          </div>
          <h3 class="text-xl font-heading text-navy mb-3">{service.name}</h3>
          <p class="text-body font-body mb-6 flex-grow">{service.shortDescription}</p>
          <a
            href={`/servicios#${service.id}`}
            class="arrow-link text-accent hover:text-accent-dark font-semibold font-body transition-colors duration-200"
          >
            Saber más <span class="arrow">&rarr;</span>
          </a>
        </div>
      ))}
    </div>

    <div class="text-center mt-12 scroll-reveal">
      <a
        href="/servicios"
        class="arrow-link text-accent hover:text-accent-dark font-semibold font-body text-lg transition-colors duration-200"
      >
        Ver todos los servicios <span class="arrow">&rarr;</span>
      </a>
    </div>
  </div>
</section>
