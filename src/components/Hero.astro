---

<section class="relative min-h-[85vh] flex items-center justify-center bg-gradient-to-br from-navy to-navy-light overflow-hidden">
  <div class="relative z-10 max-w-4xl mx-auto px-4 text-center text-white">
    <h1 class="font-heading text-5xl md:text-6xl lg:text-7xl mb-6 leading-tight">
      Tu Recuperación, Nuestra Prioridad
    </h1>
    <p class="text-xl max-w-2xl mx-auto text-slate-200 opacity-90 mb-10 font-body">
      Fisioterapia especializada en ortopedia deportiva en Costa del Este, Ciudad de Panamá
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="https://wa.me/50767573153?text=Hola%2C%20me%20gustaría%20agendar%20una%20cita"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-accent hover:bg-accent-dark text-white font-semibold rounded-full px-8 py-4 transition-colors duration-300"
      >
        Agendar Cita
      </a>
      <a
        href="/servicios"
        class="border-2 border-white text-white hover:bg-white hover:text-navy font-semibold rounded-full px-8 py-4 transition-colors duration-300"
      >
        Conoce Nuestros Servicios
      </a>
    </div>
  </div>

  <!-- Decorative bottom wave -->
  <div class="absolute bottom-0 left-0 w-full leading-none">
    <svg
      class="block w-full"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 1440 120"
      preserveAspectRatio="none"
    >
      <path
        fill="#FAFAF9"
        d="M0,64 C360,120 720,0 1080,64 C1260,96 1380,80 1440,64 L1440,120 L0,120 Z"
      />
    </svg>
  </div>
</section>
