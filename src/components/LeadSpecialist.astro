---
---

<section class="bg-white py-20">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Photo Placeholder -->
      <div class="scroll-reveal-left relative">
        <div class="relative aspect-[3/4] rounded-2xl bg-[#F0F4F8] flex items-center justify-center max-w-md mx-auto overflow-hidden">
          <!-- Corner brackets -->
          <div class="absolute top-4 left-4 w-8 h-8 border-t-2 border-l-2 border-[#00C2FF]/40" aria-hidden="true"></div>
          <div class="absolute top-4 right-4 w-8 h-8 border-t-2 border-r-2 border-[#00C2FF]/40" aria-hidden="true"></div>
          <div class="absolute bottom-4 left-4 w-8 h-8 border-b-2 border-l-2 border-[#00C2FF]/40" aria-hidden="true"></div>
          <div class="absolute bottom-4 right-4 w-8 h-8 border-b-2 border-r-2 border-[#00C2FF]/40" aria-hidden="true"></div>
          <!-- Initials circle -->
          <div class="w-24 h-24 rounded-full bg-[#1B2545] flex items-center justify-center">
            <span class="text-white text-3xl font-black tracking-tight">EA</span>
          </div>
        </div>
        <!-- Experience overlay card -->
        <div class="absolute bottom-6 left-6 bg-[#1B2545] text-white px-5 py-3 rounded-xl shadow-elevated">
          <span class="text-[#00C2FF] text-2xl font-extrabold">15+</span>
          <span class="block text-sm text-white/80">anos de experiencia</span>
        </div>
      </div>

      <!-- Content -->
      <div class="scroll-reveal-right">
        <div class="inline-flex items-center gap-2 bg-[#E6F9FF] rounded-full px-4 py-1.5 mb-4">
          <span class="w-2 h-2 rounded-full bg-[#00C2FF]"></span>
          <span class="text-[#00A3D9] text-sm font-semibold">Director Clinico</span>
        </div>

        <h2 class="text-4xl md:text-5xl font-black text-[#0F172A] uppercase tracking-tight mb-6">
          LIC. ERIC AROSEMENA
        </h2>

        <p class="text-[#334155] text-lg leading-relaxed mb-8">
          Fisioterapeuta con mas de 15 anos de experiencia en rehabilitacion ortopedica y deportiva. Especializado en devolver a cada paciente a su maximo rendimiento, desde atletas de elite hasta personas que buscan una vida activa sin dolor.
        </p>

        <!-- Credentials -->
        <div class="space-y-4 mb-8">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[#E6F9FF] flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-[#00C2FF]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-[#0F172A] font-semibold">Magister en Readaptacion y Prevencion de Lesiones Deportivas</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[#E6F9FF] flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-[#00C2FF]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-[#0F172A] font-semibold">Fisioterapeuta Oficial de la Seleccion Nacional de Panama</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[#E6F9FF] flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-[#00C2FF]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-[#0F172A] font-semibold">Especialista en Ortopedia Deportiva</span>
          </div>
        </div>

        <a href="/equipo" class="arrow-link text-[#00C2FF] hover:text-[#00A3D9] font-semibold transition-colors duration-200">
          Conoce al equipo completo <span class="arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>
