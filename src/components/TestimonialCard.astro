---
interface Props {
  name: string;
  role: string;
  quote: string;
  rating: number;
}

const { name, role, quote, rating } = Astro.props;

const stars = Array.from({ length: rating }, (_, i) => i);
---

<div class="scroll-reveal stagger-item card-hover bg-white rounded-2xl p-8 shadow-sm transition-all duration-300 relative overflow-hidden">
  <!-- Accent gradient top border -->
  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-accent via-accent-dark to-accent"></div>

  <!-- Star Rating -->
  <div class="flex gap-1">
    {stars.map(() => (
      <span class="text-amber-400 text-lg">&#9733;</span>
    ))}
  </div>

  <!-- Quote -->
  <p class="italic text-body mt-4 leading-relaxed">"{quote}"</p>

  <!-- Author -->
  <div class="mt-6">
    <p class="font-bold text-dark">{name}</p>
    <p class="text-sm text-slate-blue">{role}</p>
  </div>
</div>
