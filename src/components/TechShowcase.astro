---
const equipment = [
  {
    name: "Ondas de Choque Radiales",
    description: "Tratamiento no invasivo para tendinitis cronicas, calcificaciones y lesiones que no responden a terapia convencional.",
    image: "/images/tech-ondas-choque.jpg",
  },
  {
    name: "Tecarterapia",
    description: "Tecnologia de radiofrecuencia que estimula la regeneracion natural de los tejidos y acelera la recuperacion.",
    image: "/images/tech-tecarterapia.jpg",
  },
  {
    name: "Game Ready",
    description: "Sistema de crioterapia y compresion simultanea utilizado por equipos profesionales para recovery post-entrenamiento.",
    image: "/images/tech-game-ready.jpg",
  },
  {
    name: "VertiMax",
    description: "Plataforma de entrenamiento de resistencia variable para potencia explosiva y readaptacion deportiva.",
    image: "/images/tech-vertimax.jpg",
  },
  {
    name: "Sistemas Inerciales",
    description: "Tecnologia de entrenamiento excentrico para fortalecimiento muscular y prevencion de lesiones.",
    image: "/images/tech-inerciales.jpg",
  },
];
---

<section class="relative py-24 overflow-hidden" style="background: #1B2545;">
  <!-- Grid pattern -->
  <div class="absolute inset-0" style="background-image: linear-gradient(rgba(0,194,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(0,194,255,0.03) 1px, transparent 1px); background-size: 40px 40px;" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4">
    <div class="text-center mb-14 scroll-reveal">
      <p class="text-[#00C2FF] text-sm font-semibold uppercase tracking-widest mb-3">Tecnologia</p>
      <h2 class="text-4xl md:text-5xl text-white font-black uppercase tracking-tight mb-4">
        Equipos de Elite
      </h2>
      <div class="w-16 h-1 bg-[#00C2FF] rounded mx-auto"></div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {equipment.map((item) => (
        <div class="scroll-reveal stagger-item group rounded-2xl p-6 border border-white/10 bg-white/5 backdrop-blur-sm hover:bg-white/10 transition-all duration-300">
          <div class="aspect-video rounded-xl mb-5 overflow-hidden border border-white/10">
            <img
              src={item.image}
              alt={item.name}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <h3 class="text-white font-bold text-lg mb-2">{item.name}</h3>
          <p class="text-[#6B7DB3] text-sm leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
