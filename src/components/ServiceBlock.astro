---
interface Props {
  id: string;
  name: string;
  icon: string;
  fullDescription: string;
  treatments: string[];
  reversed: boolean;
}

const { id, name, icon, fullDescription, treatments, reversed } = Astro.props;

const serviceIcons: Record<string, string> = {
  "ortopedia": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2C12 2 10 4 10 6s1 3 2 4c1-1 2-2 2-4s-2-4-2-4zM12 10c-1 1-2 2-2 4s2 4 2 4 2-2 2-4-1-3-2-4zM12 18c-1 1-1.5 2-1.5 3s.5 2 1.5 2 1.5-1 1.5-2-.5-2-1.5-3z"/></svg>`,
  "fisioterapia-deportiva": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
  "rehabilitacion-ortopedica": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
  "readaptacion-deportiva": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>`,
  "adulto-mayor": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`,
  "ondas-choque": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
  "tecarterapia": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
  "nutricion-deportiva": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`,
  "fisioterapia-domicilio": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
  "recovery-deportivo": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`,
};

const iconHtml = serviceIcons[id] || "";
---

<section id={id} class:list={["py-20 relative", reversed ? "bg-ice" : "bg-white"]}>
  <div class="max-w-7xl mx-auto px-4">
    <!-- Top gradient line divider -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-0.5 bg-gradient-to-r from-transparent via-accent/30 to-transparent"></div>
    <div
      class:list={[
        "grid grid-cols-1 lg:grid-cols-2 gap-12 items-start",
        reversed && "direction-reverse",
      ]}
    >
      <!-- Info Column -->
      <div class:list={[reversed ? "lg:order-2 scroll-reveal-right" : "scroll-reveal-left"]}>
        {iconHtml ? (
          <div class="icon-container mb-5 text-accent" set:html={iconHtml} />
        ) : (
          <div class="text-5xl mb-4">{icon}</div>
        )}
        <h2 class="text-3xl font-heading text-navy mb-4">{name}</h2>
        <p class="text-body leading-relaxed">{fullDescription}</p>
      </div>

      <!-- Treatments Column -->
      <div class:list={[reversed ? "lg:order-1 scroll-reveal-left" : "scroll-reveal-right"]}>
        <h3 class="text-lg font-heading text-navy mb-6">Tratamientos incluidos</h3>
        <ul class="space-y-3">
          {treatments.map((treatment) => (
            <li class="flex items-start gap-3 stagger-item scroll-reveal">
              <svg
                class="w-5 h-5 text-accent mt-0.5 shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M5 13l4 4L19 7"
                />
              </svg>
              <span class="text-body">{treatment}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
