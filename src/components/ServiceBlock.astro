---
interface Props {
  id: string;
  name: string;
  icon: string;
  fullDescription: string;
  treatments: string[];
  reversed: boolean;
}

const { id, name, icon, fullDescription, treatments, reversed } = Astro.props;

const serviceIcons: Record<string, string> = {
  "ortopedia": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2v4m0 12v4M8 6a4 4 0 018 0v2a2 2 0 01-2 2h-4a2 2 0 01-2-2V6zm0 10a2 2 0 012-2h4a2 2 0 012 2v2a4 4 0 01-8 0v-2z"/></svg>`,
  "fisioterapia-deportiva": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="14" cy="4" r="2" stroke-width="1.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21l3-7m4-4l3-3m-3 3l-4 4-3-1m7-3l2 5m-2-5H9.5"/></svg>`,
  "rehabilitacion-ortopedica": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v4m0 0H8m4 0h4M9 20l3-6 3 6M5 14h14"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v6"/></svg>`,
  "readaptacion-deportiva": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>`,
  "adulto-mayor": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="4.5" r="2" stroke-width="1.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 8h-2a1 1 0 00-1 1v5h1v7h2v-7h1V9a1 1 0 00-1-1zm-5 6l-2 7m0 0h2"/></svg>`,
  "ondas-choque": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" stroke-width="1.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/><circle cx="12" cy="12" r="7" stroke-width="1" stroke-dasharray="3 2"/></svg>`,
  "tecarterapia": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 17c2-4 4-8 9-8s7 4 9 8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 15c1.5-3 3-5 6-5s4.5 2 6 5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 13c1-1.5 1.8-2.5 3-2.5s2 1 3 2.5"/></svg>`,
  "nutricion-deportiva": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1M5 12H4m16 0h1"/><circle cx="12" cy="12" r="5" stroke-width="1.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v6m-3-3h6"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 3.5c-1-.3-2-.5-3-.5s-2 .2-3 .5M15 20.5c-1 .3-2 .5-3 .5s-2-.2-3-.5"/></svg>`,
  "fisioterapia-domicilio": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
  "recovery-deportivo": `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`,
};

const iconHtml = serviceIcons[id] || "";
---

<section id={id} class:list={["py-20 relative", reversed ? "bg-ice" : "bg-white"]}>
  <div class="max-w-7xl mx-auto px-4">
    <!-- Top gradient line divider -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-0.5 bg-gradient-to-r from-transparent via-accent/30 to-transparent"></div>
    <div
      class:list={[
        "grid grid-cols-1 lg:grid-cols-2 gap-12 items-start",
        reversed && "direction-reverse",
      ]}
    >
      <!-- Info Column -->
      <div class:list={[reversed ? "lg:order-2 scroll-reveal-right" : "scroll-reveal-left"]}>
        {iconHtml ? (
          <div class="icon-container mb-5 text-accent" set:html={iconHtml} />
        ) : (
          <div class="text-5xl mb-4">{icon}</div>
        )}
        <h2 class="text-3xl font-heading text-navy mb-4">{name}</h2>
        <p class="text-body leading-relaxed">{fullDescription}</p>
      </div>

      <!-- Treatments Column -->
      <div class:list={[reversed ? "lg:order-1 scroll-reveal-left" : "scroll-reveal-right"]}>
        <h3 class="text-lg font-heading text-navy mb-6">Tratamientos incluidos</h3>
        <ul class="space-y-3">
          {treatments.map((treatment) => (
            <li class="flex items-start gap-3 stagger-item scroll-reveal">
              <svg
                class="w-5 h-5 text-accent mt-0.5 shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M5 13l4 4L19 7"
                />
              </svg>
              <span class="text-body">{treatment}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
