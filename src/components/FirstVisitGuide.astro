---
const steps = [
  {
    number: 1,
    icon: `<svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>`,
    title: "Agenda Tu Cita",
    description: "Contáctanos por WhatsApp, teléfono o formulario para reservar tu horario.",
  },
  {
    number: 2,
    icon: `<svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
    title: "Trae Tus Documentos",
    description: "Lleva ropa cómoda, estudios de imagen si los tienes, y tu carnet de seguro.",
  },
  {
    number: 3,
    icon: `<svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>`,
    title: "Evaluación Completa",
    description: "Realizamos una evaluación integral de 60 minutos para entender tu condición.",
  },
  {
    number: 4,
    icon: `<svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>`,
    title: "Plan de Tratamiento",
    description: "Recibes un plan personalizado con objetivos claros y plazos estimados.",
  },
];
---

<section class="bg-ice py-16">
  <div class="max-w-7xl mx-auto px-4">
    <!-- Section Heading -->
    <div class="text-center mb-12 scroll-reveal">
      <h2 class="text-3xl md:text-4xl font-heading text-navy mb-4">Tu Primera Visita</h2>
      <p class="text-body max-w-2xl mx-auto">
        Todo lo que necesitas saber para tu primera cita en FisioGMED
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 relative">
      <!-- Connecting line (visible on lg screens) -->
      <div class="hidden lg:block absolute top-16 left-[12.5%] right-[12.5%] h-0.5 bg-gradient-to-r from-accent/20 via-accent/40 to-accent/20" aria-hidden="true"></div>

      {steps.map((step) => (
        <div class="scroll-reveal stagger-item card-hover bg-white rounded-2xl p-6 shadow-sm text-center relative z-10">
          <!-- Step Number -->
          <div class="w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-lg font-bold mx-auto mb-4" style="box-shadow: 0 4px 12px rgba(232, 127, 53, 0.3);">
            {step.number}
          </div>

          <!-- Icon -->
          <div class="flex justify-center mb-3" set:html={step.icon} />

          <!-- Title -->
          <h3 class="text-lg font-heading text-navy mb-2">{step.title}</h3>

          <!-- Description -->
          <p class="text-body text-sm leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
