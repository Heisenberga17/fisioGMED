---
const stats = [
  {
    number: "+10",
    target: "+10",
    label: "Anos de Experiencia",
  },
  {
    number: "+5,000",
    target: "+5,000",
    label: "Pacientes Atendidos",
  },
  {
    number: "5.0",
    target: "5.0",
    label: "Calificacion Google",
  },
  {
    number: "Seleccion",
    target: null,
    label: "Nacional de Panama",
  },
];
---

<section class="relative z-20 -mt-12 pb-8">
  <div class="max-w-7xl mx-auto px-4">
    <div class="bg-white/80 backdrop-blur rounded-2xl shadow-elevated py-10 px-8 border border-white/60 max-w-5xl mx-auto" style="box-shadow: var(--shadow-elevated);">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {stats.map((stat) => (
          <div class="trust-stat scroll-reveal stagger-item text-center">
            {stat.target ? (
              <div class="text-4xl font-extrabold text-navy tracking-tight" data-target={stat.target}>0</div>
            ) : (
              <div class="text-4xl font-extrabold text-navy tracking-tight">{stat.number}</div>
            )}
            <div class="text-body text-sm mt-2">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
