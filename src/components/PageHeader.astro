---
interface Props {
  title: string;
  subtitle?: string;
  waveFill?: string;
}

const { title, subtitle, waveFill = "#FAFAF9" } = Astro.props;
---

<section class="bg-navy pt-12 md:pt-16 pb-20 md:pb-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center justify-center gap-2 text-sm">
        <li>
          <a
            href="/"
            class="text-slate-blue hover:text-white transition-colors duration-200"
          >
            Inicio
          </a>
        </li>
        <li class="text-slate-blue" aria-hidden="true">
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <span class="text-white font-medium">{title}</span>
        </li>
      </ol>
    </nav>

    <!-- Title -->
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-heading text-white mb-4">
      {title}
    </h1>

    <!-- Subtitle -->
    {
      subtitle && (
        <p class="text-slate-blue text-lg md:text-xl max-w-2xl mx-auto">
          {subtitle}
        </p>
      )
    }
  </div>

  <!-- Bottom Wave -->
  <div class="absolute bottom-0 left-0 w-full leading-none">
    <svg class="block w-full" viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path fill={waveFill} d="M0,48 C240,80 480,16 720,48 C960,80 1200,16 1440,48 L1440,80 L0,80 Z"/>
    </svg>
  </div>
</section>
