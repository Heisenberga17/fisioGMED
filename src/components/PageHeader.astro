---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="bg-navy pt-28 md:pt-36 pb-20 md:pb-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center justify-center gap-2 text-sm">
        <li>
          <a
            href="/"
            class="text-slate-blue hover:text-white transition-colors duration-200"
          >
            Inicio
          </a>
        </li>
        <li class="text-slate-blue" aria-hidden="true">
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </li>
        <li>
          <span class="text-white font-medium">{title}</span>
        </li>
      </ol>
    </nav>

    <!-- Title -->
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-heading text-white mb-4">
      {title}
    </h1>

    <!-- Subtitle -->
    {
      subtitle && (
        <p class="text-slate-blue text-lg md:text-xl max-w-2xl mx-auto">
          {subtitle}
        </p>
      )
    }
  </div>
</section>
