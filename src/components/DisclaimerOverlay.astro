<style>
  .disclaimer-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-navy);
    transition: opacity 0.4s ease, visibility 0.4s ease;
    overflow-y: auto;
  }

  .disclaimer-overlay.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .disclaimer-content {
    text-align: center;
    max-width: 500px;
    padding: 2.5rem 1.5rem;
  }

  .disclaimer-greeting {
    color: var(--color-accent);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .disclaimer-name {
    color: #fff;
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
    letter-spacing: -0.02em;
  }

  .disclaimer-role {
    color: var(--color-slate-blue);
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 0;
  }

  .disclaimer-divider {
    width: 40px;
    height: 2px;
    background: var(--color-accent);
    opacity: 0.4;
    margin: 1.5rem auto;
  }

  .disclaimer-text {
    color: var(--color-slate-blue);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 0;
  }

  .disclaimer-text strong {
    color: #fff;
  }

  .disclaimer-label {
    color: var(--color-slate-blue);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }

  .disclaimer-links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
  }

  .disclaimer-links a {
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .disclaimer-links a:hover {
    color: #fff;
  }

  .badge-dev {
    font-size: 0.65rem;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    opacity: 0.7;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    margin-left: 0.25rem;
    vertical-align: middle;
  }

  .disclaimer-contact {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .contact-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 1rem;
    border: 1px solid var(--color-slate-blue);
    border-radius: 100px;
    color: var(--color-slate-blue);
    text-decoration: none;
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }

  .contact-chip:hover {
    color: #fff;
    border-color: #fff;
  }

  .contact-chip-wa:hover {
    color: #25D366;
    border-color: #25D366;
  }

  .contact-chip svg {
    flex-shrink: 0;
  }

  .disclaimer-btn {
    display: inline-block;
    padding: 0.8rem 2.5rem;
    background: var(--color-accent);
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .disclaimer-btn:hover {
    background: var(--color-accent-dark);
    transform: translateY(-1px);
  }

  .disclaimer-btn:active {
    transform: translateY(0);
  }

  @media (max-width: 480px) {
    .disclaimer-name {
      font-size: 1.75rem;
    }

    .disclaimer-content {
      padding: 2rem 1.25rem;
    }
  }
</style>

<script>
  const overlay = document.getElementById('disclaimer-overlay');
  const btn = document.getElementById('disclaimer-continue');

  if (sessionStorage.getItem('disclaimer-accepted')) {
    overlay?.classList.add('hidden');
  }

  btn?.addEventListener('click', () => {
    sessionStorage.setItem('disclaimer-accepted', '1');
    overlay?.classList.add('hidden');
  });
</script>
