---
interface Props {
  name: string;
  role: string;
  bio: string;
  isLead?: boolean;
}

const { name, role, bio, isLead = false } = Astro.props;
---

{isLead ? (
  <div class="lg:col-span-2 bg-white rounded-2xl shadow-md overflow-hidden">
    <div class="grid grid-cols-1 md:grid-cols-2">
      <!-- Placeholder Image -->
      <div class="bg-gray-200 h-64 md:h-full min-h-[16rem] flex items-center justify-center">
        <div class="text-center">
          <svg
            class="w-20 h-20 mx-auto text-gray-400"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z" />
          </svg>
          <p class="text-gray-400 mt-2 text-sm">Foto próximamente</p>
        </div>
      </div>

      <!-- Info -->
      <div class="p-8 flex flex-col justify-center">
        <p class="text-accent font-medium text-sm uppercase tracking-wider">{role}</p>
        <h3 class="text-2xl font-heading text-navy mt-1">{name}</h3>
        <p class="text-body mt-3 leading-relaxed">{bio}</p>
      </div>
    </div>
  </div>
) : (
  <div class="bg-white rounded-2xl shadow-md overflow-hidden">
    <!-- Placeholder Image -->
    <div class="bg-gray-200 h-64 flex items-center justify-center">
      <div class="text-center">
        <svg
          class="w-16 h-16 mx-auto text-gray-400"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z" />
        </svg>
        <p class="text-gray-400 mt-2 text-sm">Foto próximamente</p>
      </div>
    </div>

    <!-- Info -->
    <div class="p-6">
      <p class="text-accent font-medium text-sm uppercase tracking-wider">{role}</p>
      <h3 class="text-xl font-heading text-navy mt-1">{name}</h3>
      <p class="text-body mt-2">{bio}</p>
    </div>
  </div>
)}
