---
interface Props {
  name: string;
  role: string;
  bio: string;
}

const { name, role, bio } = Astro.props;

// Get initials for styled placeholder
const initials = name.split(' ').filter(w => w.length > 1).slice(0, 2).map(w => w[0]).join('');
---

<div class="scroll-reveal stagger-item bg-white rounded-2xl shadow-md overflow-hidden card-hover border border-navy/[0.06]">
  <!-- Styled Placeholder Image -->
  <div class="bg-gradient-to-br from-navy/80 to-slate-blue h-64 flex items-center justify-center">
    <div class="text-center">
      <div class="w-20 h-20 rounded-full bg-white/15 backdrop-blur-sm border border-white/20 flex items-center justify-center mx-auto mb-3">
        <span class="text-2xl font-heading text-white">{initials}</span>
      </div>
      <p class="text-white/60 mt-2 text-sm">Foto próximamente</p>
    </div>
  </div>

  <!-- Info -->
  <div class="p-6">
    <p class="text-accent font-medium text-sm uppercase tracking-wider">{role}</p>
    <h3 class="text-xl font-heading text-navy mt-1">{name}</h3>
    <p class="text-body mt-2">{bio}</p>
  </div>
</div>
